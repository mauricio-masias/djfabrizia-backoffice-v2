APP_NAME="DJ Fabrizia Backoffice"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:6060

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
CMS_EDITOR_TIMEZONE=Europe/London

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=djdb
DB_PORT=3306
DB_DATABASE=djfabriz_cms
DB_USERNAME=cms_rw
DB_PASSWORD=

# WordPress v1 database (read-only, importer source)
WP_DB_HOST=djdb
WP_DB_PORT=3306
WP_DB_DATABASE=djfabriz_headless
WP_DB_USERNAME=importer_ro
WP_DB_PASSWORD=
WP_DB_PREFIX=dj_
WP_UPLOADS_PATH=/mnt/wp-uploads

# Endpoint DB users, created by docker/scripts/bootstrap-db.sh.
# Copy these into djfabrizia-endpoint/.env (CMS_DB_PASSWORD / DB_PASSWORD).
ENDPOINT_RO_PASSWORD=
ENDPOINT_RW_PASSWORD=

# Admin user created by AdminUserSeeder
CMS_ADMIN_NAME="Admin"
CMS_ADMIN_EMAIL=
CMS_ADMIN_PASSWORD=

# Endpoint integration (cache warm + preview)
ENDPOINT_URL=http://djendpoint:8080
ENDPOINT_WARM_TOKEN=
ENDPOINT_PREVIEW_TOKEN=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Content syncs (Mixcloud needs no credentials)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
YOUTUBE_API_KEY=
